{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}
    },
    {
      "name": "sanitize",
      "displayName": "Sanitizers",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "HASHBENCH_SANITIZERS": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "sanitize", "configurePreset": "sanitize"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}}
  ]
}
